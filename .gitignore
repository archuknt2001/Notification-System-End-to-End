# ============================================================
# AI-Native CRM Notification System — root .gitignore
# ============================================================

# ----------------------------------------------------------
# Python
# ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# Distribution / build
build/
dist/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/

# pytest / testing
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
test-results/

# mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# ----------------------------------------------------------
# Environment / secrets
# ----------------------------------------------------------
.env
.env.*
!.env.example

# ----------------------------------------------------------
# Node.js / Frontend
# ----------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
package-lock.json

# Frontend build output
frontend/dist/
frontend/build/
frontend/.vite/

# ----------------------------------------------------------
# IDE / Editor
# ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----------------------------------------------------------
# Alembic
# ----------------------------------------------------------
# Keep migrations, but ignore any local override files
alembic/versions/__pycache__/

# ----------------------------------------------------------
# Logs
# ----------------------------------------------------------
*.log
logs/
